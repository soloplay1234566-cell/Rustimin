{
  "name": "rustimin",
  "version": "1.0.0",
  "private": true,
  "description": "Atmospheric desktop music player with local library, synchronized lyrics and world radio",
  "author": "Rustimin",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "test": "node --import tsx tests/model.test.ts",
    "test:e2e": "playwright test",
    "package:win": "npm run build && electron-builder --win zip --x64",
    "package:linux": "npm run build && electron-builder --linux dir --x64"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "app.rustimin.player",
    "productName": "Rustimin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false,
      "artifactName": "Rustimin-${version}-Windows-x64.${ext}"
    },
    "linux": {
      "target": "dir",
      "category": "AudioVideo"
    },
    "extraFiles": [
      {
        "from": "WINDOWS-START.txt",
        "to": "НАЧНИТЕ ЗДЕСЬ.txt"
      }
    ]
  }
}
